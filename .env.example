# Copy to .env and fill in. Never commit .env.

# Required in production: the HMAC key for session cookies (32+ random characters).
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Set to true when the app is served over https (marks the session cookie Secure).
COOKIE_SECURE=false

# --- database (MySQL 8.4, see compose.yaml) ---
# Required. Dev: `npm run db:up` (podman compose up -d db) listens on 127.0.0.1:3307.
# compose.yaml sets the app container's own URL (db:3306), so this line is for npm run dev/tests.
DATABASE_URL=mysql://newspaper:newspaper@127.0.0.1:3307/newspaper
# Passwords of the compose db service (defaults: newspaper / newspaper-root). Change both in
# production before the first `podman compose up` (they are fixed when the volume is created).
# MYSQL_PASSWORD=newspaper
# MYSQL_ROOT_PASSWORD=newspaper-root
# Integration tests create throwaway newspaper_test_* databases with this account.
# TEST_DATABASE_ADMIN_URL=mysql://root:newspaper-root@127.0.0.1:3307
# CI sets REQUIRE_TEST_DB=1: an unreachable MySQL then fails the DB tests instead of skipping them.
# REQUIRE_TEST_DB=1

# --- Google sign-in (see README "Google sign-in") ---
# Without a client id and secret only the local admin login (users.json) is offered.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The origin people use to reach the app; the OAuth redirect URI is <origin>/auth/google/callback.
# Dev: http://localhost:5173. Production must be https on a public domain (Google rejects LAN IPs).
PUBLIC_ORIGIN=http://localhost:5173
# Comma-separated emails that become approved admins on their first Google sign-in.
ADMIN_EMAILS=
# Testing only: another OpenID issuer (default https://accounts.google.com).
# GOOGLE_ISSUER=

# --- legal pages (/privacidad, /condiciones; see README "Google consent screen") ---
# Who runs this newsstand (the data controller) and where privacy requests go. Without them the
# pages say "el administrador de este quiosco" and use the first ADMIN_EMAILS address.
# LEGAL_OPERATOR_NAME=
# LEGAL_CONTACT_EMAIL=

# --- observability (see README "Observability") ---
# Prometheus /metrics on its own port, LAN only. 0 or empty disables it.
# METRICS_PORT=9464
# Interface to bind (default all). Inside the container keep 0.0.0.0 and use METRICS_BIND below.
# METRICS_HOST=0.0.0.0
# Source CIDRs allowed to scrape (default: loopback, 10/8, 172.16/12, 192.168/16, ::1, fc00::/7, fe80::/10).
# METRICS_ALLOW=192.168.1.0/24
# Traces are exported only when one of these is set (OTLP over http/protobuf, e.g. Jaeger :4318).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_TRACES_EXPORTER=console
# OTEL_SERVICE_NAME=newspaper

# --- local development (npm run dev / node build) ---
# The shared flat folder of PDFs (read-only for the app).
NEWSPAPER_DIR=./newspapers
# Writable app data: users.json, regions.json, thumbs/.
DATA_DIR=./data
# Testing only: true skips the login under `npm run dev` (ignored by `node build`).
AUTH_DISABLED=false

# --- compose.yaml ---
# Host folder mounted read-only at /newspapers.
NEWSPAPER_HOST_DIR=./newspapers
# Host port.
NEWSPAPER_PORT=3000
# Host address and port that publish the container's /metrics (default 127.0.0.1:9464).
# Set METRICS_BIND to this machine's LAN IP for a Prometheus elsewhere on the LAN.
# METRICS_BIND=127.0.0.1
# METRICS_HOST_PORT=9464
# Image to run (defaults to the locally built one).
# NEWSPAPER_IMAGE=localhost/newspaper:latest
