# Copy to .env and fill in. Never commit .env.

# Required in production: the HMAC key for session cookies (32+ random characters).
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Set to true when the app is served over https (marks the session cookie Secure).
COOKIE_SECURE=false

# --- local development (npm run dev / node build) ---
# The shared flat folder of PDFs (read-only for the app).
NEWSPAPER_DIR=./newspapers
# Writable app data: users.json, regions.json, thumbs/.
DATA_DIR=./data

# --- compose.yaml ---
# Host folder mounted read-only at /newspapers.
NEWSPAPER_HOST_DIR=./newspapers
# Host port.
NEWSPAPER_PORT=3000
# Image to run (defaults to the locally built one).
# NEWSPAPER_IMAGE=localhost/newspaper:latest
