# Copy to .env and fill in. Never commit .env.

# Required in production: the HMAC key for session cookies (32+ random characters).
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Set to true when the app is served over https (marks the session cookie Secure).
COOKIE_SECURE=false

# --- observability (see README "Observability") ---
# Prometheus /metrics on its own port, LAN only. 0 or empty disables it.
# METRICS_PORT=9464
# Interface to bind (default all). Inside the container keep 0.0.0.0 and use METRICS_BIND below.
# METRICS_HOST=0.0.0.0
# Source CIDRs allowed to scrape (default: loopback, 10/8, 172.16/12, 192.168/16, ::1, fc00::/7, fe80::/10).
# METRICS_ALLOW=192.168.1.0/24
# Traces are exported only when one of these is set (OTLP over http/protobuf, e.g. Jaeger :4318).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_TRACES_EXPORTER=console
# OTEL_SERVICE_NAME=newspaper

# --- local development (npm run dev / node build) ---
# The shared flat folder of PDFs (read-only for the app).
NEWSPAPER_DIR=./newspapers
# Writable app data: users.json, regions.json, thumbs/.
DATA_DIR=./data
# Testing only: true skips the login under `npm run dev` (ignored by `node build`).
AUTH_DISABLED=false

# --- compose.yaml ---
# Host folder mounted read-only at /newspapers.
NEWSPAPER_HOST_DIR=./newspapers
# Host port.
NEWSPAPER_PORT=3000
# Host address and port that publish the container's /metrics (default 127.0.0.1:9464).
# Set METRICS_BIND to this machine's LAN IP for a Prometheus elsewhere on the LAN.
# METRICS_BIND=127.0.0.1
# METRICS_HOST_PORT=9464
# Image to run (defaults to the locally built one).
# NEWSPAPER_IMAGE=localhost/newspaper:latest
