{
	"name": "newspaper",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"user:add": "node scripts/user.ts add",
		"user:remove": "node scripts/user.ts remove",
		"samples": "node scripts/make-samples.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/newsreader": "^5.3.0",
		"@sveltejs/adapter-node": "^6.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^24",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	},
	"engines": {
		"node": ">=24"
	},
	"dependencies": {
		"@opentelemetry/api": "^1.10.0",
		"@opentelemetry/auto-instrumentations-node": "^0.83.1",
		"@opentelemetry/exporter-prometheus": "^0.301.2",
		"@opentelemetry/exporter-trace-otlp-proto": "^0.301.2",
		"@opentelemetry/resources": "^3.1.1",
		"@opentelemetry/sdk-metrics": "^3.1.1",
		"@opentelemetry/sdk-node": "^0.301.2",
		"@opentelemetry/semantic-conventions": "^1.45.0",
		"import-in-the-middle": "^3.6.0"
	}
}
